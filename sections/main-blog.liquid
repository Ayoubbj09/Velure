<section class="page-width">
  <h1>{{ blog.title }}</h1>
  {% for article in blog.articles %}
    <article>
      <a href="{{ article.url }}">{{ article.title }}</a>
    </article>
  {% endfor %}
</section>

{% schema %}
{
  "name": "Main blog",
  "settings": [],
  "presets": [{ "name": "Main blog" }]
}
{% endschema %}
