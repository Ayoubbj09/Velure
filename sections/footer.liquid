<footer class="site-footer section">
  <div class="page-width site-footer__inner">
    <div>
      <p class="site-footer__brand">VELURE</p>
      <p>{{ section.settings.tagline }}</p>
    </div>
    <div class="site-footer__links">
      <a href="/collections/all">Shop</a>
      <a href="/pages/about">About</a>
      <a href="/pages/faq">FAQ</a>
      <a href="/pages/contact">Contact</a>
      <a href="{{ routes.search_url }}">Search</a>
      <a href="{{ routes.cart_url }}">Cart</a>
    </div>
  </div>
</footer>

{% schema %}
{"name":"Footer","settings":[{"type":"text","id":"tagline","label":"Tagline","default":"Premium Korean-inspired skincare for a softer, polished ritual."}]}
{% endschema %}
