<footer class="site-footer">
  <div class="page-width site-footer__inner">
    <div>
      <p class="site-footer__brand">VELURE</p>
      <p class="site-footer__text">{{ section.settings.tagline }}</p>
    </div>
    <nav class="site-footer__links" aria-label="Footer">
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      <a href="/pages/about">About</a>
      <a href="/pages/faq">FAQ</a>
      <a href="/pages/contact">Contact</a>
      <a href="{{ routes.privacy_policy_url }}">Privacy</a>
      <a href="{{ routes.terms_of_service_url }}">Terms</a>
      <a href="{{ routes.shipping_policy_url }}">Shipping</a>
      <a href="{{ routes.refund_policy_url }}">Returns</a>
    </nav>
  </div>
  <div class="page-width site-footer__bottom"><span>{{ shop.name }}</span><span>&copy; {{ 'now' | date: '%Y' }}</span></div>
</footer>

{% schema %}
{"name":"Footer","settings":[{"type":"text","id":"tagline","label":"Tagline","default":"Premium Korean-inspired skincare for a softer, polished ritual."}]}
{% endschema %}
