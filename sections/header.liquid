{% liquid
  assign menu_handle = section.settings.menu
  assign menu_links = linklists[menu_handle].links
%}

<header class="site-header{% if section.settings.sticky %} site-header--sticky{% endif %}" data-site-header>
  {% if section.settings.announcement_text != blank %}
    <div class="announcement-bar">
      <div class="page-width">
        <p>{{ section.settings.announcement_text }}</p>
      </div>
    </div>
  {% endif %}

  <div class="page-width site-header__inner">
    <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {{ section.settings.brand_text | default: shop.name }}
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__menu">
        {% if menu_links != blank %}
          {% for link in menu_links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        {% else %}
          <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
          <li><a href="/pages/about">About</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/contact">Contact</a></li>
        {% endif %}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href="{{ routes.search_url }}" aria-label="Search">Search</a>
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" aria-label="Account">Account</a>
      {% endif %}
      <a href="{{ routes.cart_url }}" aria-label="Cart">Cart ({{ cart.item_count }})</a>
      <button class="button button--ghost site-header__mobile-toggle" type="button" aria-expanded="false" aria-controls="MobileMenu" data-mobile-menu-toggle>Menu</button>
    </div>
  </div>

  <div id="MobileMenu" class="site-header__mobile-panel page-width" hidden>
    <nav aria-label="Mobile">
      <ul class="site-header__mobile-menu">
        <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
        <li><a href="/pages/about">About</a></li>
        <li><a href="/pages/faq">FAQ</a></li>
        <li><a href="/pages/contact">Contact</a></li>
        <li><a href="{{ routes.search_url }}">Search</a></li>
        <li><a href="{{ routes.cart_url }}">Cart</a></li>
      </ul>
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "brand_text", "label": "Brand text", "default": "VELURE" },
    { "type": "text", "id": "announcement_text", "label": "Announcement bar text", "default": "FREE SHIPPING ON ORDERS OVER €40" },
    { "type": "link_list", "id": "menu", "label": "Menu" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true }
  ]
}
{% endschema %}
