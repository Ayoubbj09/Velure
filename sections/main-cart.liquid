<section class="section page-width cart">
  <h1>Cart</h1>
  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" class="cart__form">
      {% for item in cart.items %}
        <article class="cart-item">
          {% if item.image %}{{ item.image | image_url: width: 360 | image_tag: class: 'cart-item__image' }}{% endif %}
          <div>
            <h2>{{ item.product.title }}</h2>
            <p>{{ item.variant.title }}</p>
            <p>{{ item.final_line_price | money }}</p>
            <label class="field-label" for="qty-{{ item.key }}">Quantity</label>
            <input id="qty-{{ item.key }}" class="field" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
          </div>
        </article>
      {% endfor %}
      <p class="cart__subtotal">Subtotal: {{ cart.total_price | money }}</p>
      <button type="submit" name="checkout" class="button button--solid">Checkout</button>
    </form>
  {% else %}
    <p>Your cart is empty.</p>
  {% endif %}
</section>

{% schema %}
{"name":"Main cart","settings":[],"presets":[{"name":"Main cart"}]}
{% endschema %}
