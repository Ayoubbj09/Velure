<section class="section page-width how-to-use">
  <div class="how-to-use__content">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <div class="rte section-copy">{{ section.settings.text }}</div>
    <div class="how-to-use__steps">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks limit: 3 %}
          <div class="how-to-use__step" {{ block.shopify_attributes }}><span>0{{ forloop.index }}</span><strong>{{ block.settings.title }}</strong><p>{{ block.settings.text }}</p></div>
        {% endfor %}
      {% else %}
        <div class="how-to-use__step"><span>01</span><strong>Swipe</strong><p>Twist up the balm.</p></div>
        <div class="how-to-use__step"><span>02</span><strong>Apply</strong><p>Glide onto the areas you need.</p></div>
        <div class="how-to-use__step"><span>03</span><strong>Blend</strong><p>Finish with your fingertips.</p></div>
      {% endif %}
    </div>
  </div>
  {% assign how_to_use_image = 'imagenn-6.png' | asset_url %}
  {% if section.settings.image != blank %}{% assign how_to_use_image = section.settings.image | image_url: width: 1600 %}{% endif %}
  <div class="how-to-use__media">
    <img class="how-to-use__image" src="{{ how_to_use_image }}" width="1024" height="1536" loading="lazy" decoding="async" alt="{{ section.settings.heading | escape }}">
  </div>
</section>
{% schema %}{ "name": "How to use", "settings": [{ "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HOW TO USE" }, { "type": "text", "id": "heading", "label": "Heading", "default": "A SIMPLE THREE-STEP RITUAL." }, { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Easy to apply whenever your skin needs a little extra hydration.</p>" }, { "type": "image_picker", "id": "image", "label": "How to use image" }], "blocks": [{ "type": "step", "name": "Step", "settings": [{ "type": "text", "id": "title", "label": "Title", "default": "Swipe" }, { "type": "text", "id": "text", "label": "Text", "default": "Twist up the balm." }] }], "presets": [{ "name": "How to use", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }] }{% endschema %}
