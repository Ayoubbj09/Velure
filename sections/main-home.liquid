<section class="hero section">
  <div class="page-width hero__grid hero__grid--{{ section.settings.image_position }}">
    <div class="hero__content">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p class="hero__text">{{ section.settings.subheading }}</p>
      <div class="hero__actions">
        {% if section.settings.button_label != blank %}
          <a class="button button--solid" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
        {% endif %}
        {% if section.settings.secondary_button_label != blank %}
          <a class="button button--ghost" href="{{ section.settings.secondary_button_link }}">{{ section.settings.secondary_button_label }}</a>
        {% endif %}
      </div>
    </div>
    <div class="hero__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1800 | image_tag: class: 'hero__image', loading: 'eager', widths: '360,540,720,900,1080,1440,1800' }}
      {% else %}
        <div class="hero__placeholder"></div>
      {% endif %}
    </div>
  </div>
</section>

<section class="section page-width benefits">
  <div class="section-heading">
    <p class="eyebrow">{{ section.settings.benefits_eyebrow }}</p>
    <h2>{{ section.settings.benefits_heading }}</h2>
  </div>
  <div class="benefits__grid">
    {% for block in section.blocks %}
      <article class="benefit" {{ block.shopify_attributes }}>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Main home",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"PREMIUM KOREAN-INSPIRED SKINCARE"},
    {"type":"text","id":"heading","label":"Heading","default":"YOUR GLOW, ANYWHERE."},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"Meet the PDRN Pink Collagen Multi Balm — a convenient skincare essential designed to add lightweight hydration and a fresh, dewy finish wherever you need it."},
    {"type":"image_picker","id":"image","label":"Hero image"},
    {"type":"select","id":"image_position","label":"Image position","default":"right","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}]},
    {"type":"text","id":"button_label","label":"Button label","default":"SHOP NOW"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"text","id":"secondary_button_label","label":"Secondary button label","default":"DISCOVER THE RITUAL"},
    {"type":"url","id":"secondary_button_link","label":"Secondary button link"},
    {"type":"text","id":"benefits_eyebrow","label":"Benefits eyebrow","default":"THE ESSENTIAL, REFINED."},
    {"type":"text","id":"benefits_heading","label":"Benefits heading","default":"THE ESSENTIAL, REFINED."}
  ],
  "blocks": [
    {"type":"benefit","name":"Benefit","settings":[{"type":"text","id":"title","label":"Title","default":"DEEP HYDRATION"},{"type":"text","id":"text","label":"Text","default":"A comfortable, lightweight finish for daily touch-ups."}]}
  ],
  "presets": [{"name":"Main home"}]
}
{% endschema %}
