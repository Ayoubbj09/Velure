<section class="hero section">
  <div class="page-width hero__grid hero__grid--{{ section.settings.image_position }}">
    <div class="hero__content">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p class="hero__text">{{ section.settings.subheading }}</p>
      <div class="hero__actions">
        {% if section.settings.button_label != blank %}
          <a class="button button--solid" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
        {% endif %}
        {% if section.settings.secondary_button_label != blank %}
          <a class="button button--ghost" href="{{ section.settings.secondary_button_link }}">{{ section.settings.secondary_button_label }}</a>
        {% endif %}
      </div>
      <div class="hero__meta">
        <span class="hero__chip">5% PDRN</span>
        <span class="hero__chip">10g</span>
        <span class="hero__chip">VELURE</span>
      </div>
    </div>
    <div class="hero__media">
      <div class="hero__stage">
        {% assign hero_image = 'images/imagenn 1.png' | asset_url %}
        {% if section.settings.image != blank %}
          {% assign hero_image = section.settings.image | image_url: width: 1800 %}
        {% endif %}
        {{ hero_image | image_tag: class: 'hero__image', loading: 'eager', widths: '360,540,720,900,1080,1440,1800', alt: section.settings.heading }}
      </div>
    </div>
  </div>
</section>

<section class="trust">
  <div class="page-width trust__row">
    <div class="trust__item">5% PDRN</div>
    <div class="trust__item">Lightweight hydration</div>
    <div class="trust__item">Multi-zone</div>
    <div class="trust__item">On-the-go</div>
  </div>
</section>

<section class="section page-width">
  <div class="section-heading">
    <p class="eyebrow">THE ESSENTIAL, REFINED.</p>
    <h2>WHY IT BELONGS IN YOUR ROUTINE.</h2>
  </div>
  <div class="benefits__grid">
    {% for block in section.blocks %}
      <article class="benefit" {{ block.shopify_attributes }}>
        <div class="benefit__index">0{{ forloop.index }}</div>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Main home",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PREMIUM KOREAN-INSPIRED SKINCARE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "YOUR GLOW, ANYWHERE." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Meet the PDRN Pink Collagen Multi Balm — a convenient skincare essential designed to add lightweight hydration and a fresh, dewy-looking finish wherever you need it." },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "right", "options": [{"value":"left","label":"Left"},{"value":"right","label":"Right"}] },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP NOW" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "secondary_button_label", "label": "Secondary button label", "default": "DISCOVER THE RITUAL" },
    { "type": "url", "id": "secondary_button_link", "label": "Secondary button link" }
  ],
  "blocks": [
    { "type": "benefit", "name": "Benefit", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Hydration" },
      { "type": "text", "id": "text", "label": "Text", "default": "Lightweight hydration whenever your skin needs it." }
    ]}
  ],
  "presets": [{"name": "Main home"}]
}
{% endschema %}
