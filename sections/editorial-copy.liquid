<section class="section page-width editorial-copy">
  <p class="eyebrow">{{ section.settings.eyebrow }}</p>
  <h2>{{ section.settings.heading }}</h2>
  <div class="rte">{{ section.settings.text }}</div>
</section>
{% schema %}
{"name":"Editorial copy","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ONE BALM. MANY MOMENTS."},{"type":"text","id":"heading","label":"Heading","default":"Keep your skincare ritual close."},{"type":"textarea","id":"text","label":"Text","default":"This compact balm stick makes it easy to refresh dry-looking areas with a lightweight, comfortable finish."}],"presets":[{"name":"Editorial copy"}]}
{% endschema %}
