<section class="section page-width hero-copy">
  <div>
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <div class="rte section-copy">{{ section.settings.text }}</div>
  </div>
  <div>
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1400 | image_tag: class: 'hero-copy__image', loading: 'lazy' }}
    {% else %}
      <div class="hero__placeholder" style="min-height:420px;"><strong>Image missing</strong><span>Add a product image here for the editorial layout.</span></div>
    {% endif %}
  </div>
</section>
{% schema %}{ "name": "Editorial copy", "settings": [{ "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE ESSENTIAL, REFINED." }, { "type": "text", "id": "heading", "label": "Heading", "default": "ONE BALM. MANY MOMENTS." }, { "type": "textarea", "id": "text", "label": "Text", "default": "Keep your skincare ritual close with a compact balm designed for easy application whenever your skin needs a little extra hydration." }, { "type": "image_picker", "id": "image", "label": "Image" }], "presets": [{ "name": "Editorial copy" }] }{% endschema %}
