<section class="section page-width faq">
  <div class="section-heading">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
  </div>
  {% for block in section.blocks %}
    <details {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
      <summary>{{ block.settings.question }}</summary>
      <div class="rte">{{ block.settings.answer }}</div>
    </details>
  {% endfor %}
</section>
{% schema %}
{"name":"FAQ accordion","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"FAQ"},{"type":"text","id":"heading","label":"Heading","default":"Frequently asked questions"}],"blocks":[{"type":"qa","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"What is the PDRN Pink Collagen Multi Balm?"},{"type":"textarea","id":"answer","label":"Answer","default":"A compact skincare balm designed for lightweight hydration and a fresh-looking finish."}]}],"presets":[{"name":"FAQ accordion","blocks":[{"type":"qa"},{"type":"qa"},{"type":"qa"}]}]}
{% endschema %}
