<section class="section page-width final-cta">
  <div class="final-cta__content">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p class="section-copy">{{ section.settings.text }}</p>
    {% if section.settings.button_label != blank %}<a class="button button--solid" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}
  </div>
  {% assign cta_image = 'imagenn-7.png' | asset_url %}
  {% if section.settings.image != blank %}{% assign cta_image = section.settings.image | image_url: width: 1400 %}{% endif %}
  <div class="final-cta__media">
    <img class="final-cta__image" src="{{ cta_image }}" width="1024" height="1536" loading="lazy" decoding="async" alt="{{ section.settings.heading | escape }}">
  </div>
</section>
{% schema %}{ "name": "Final CTA", "settings": [{ "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FINAL CTA" }, { "type": "text", "id": "heading", "label": "Heading", "default": "MAKE GLOW PART OF YOUR EVERYDAY." }, { "type": "textarea", "id": "text", "label": "Text", "default": "A simple step for a more considered skincare ritual." }, { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP THE BALM" }, { "type": "url", "id": "button_link", "label": "Button link" }, { "type": "image_picker", "id": "image", "label": "Bundle / final CTA image" }], "presets": [{ "name": "Final CTA" }] }{% endschema %}
