<section class="section page-width final-cta">
  <p class="eyebrow">{{ section.settings.eyebrow }}</p>
  <h2>{{ section.settings.heading }}</h2>
  <p class="section-copy">{{ section.settings.text }}</p>
  {% if section.settings.button_label != blank %}<a class="button button--solid" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{% endif %}
</section>
{% schema %}{ "name": "Final CTA", "settings": [{ "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A QUIET DAILY RITUAL" }, { "type": "text", "id": "heading", "label": "Heading", "default": "YOUR GLOW, ANYWHERE." }, { "type": "textarea", "id": "text", "label": "Text", "default": "Keep the essential close, wherever the day takes you." }, { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP NOW" }, { "type": "url", "id": "button_link", "label": "Button link" }], "presets": [{ "name": "Final CTA" }] }{% endschema %}
